# ---- 依赖 / 运行环境 ----
.venv/
venv/
__pycache__/
*.pyc
*.pyo
# 前端依赖（实际是指向 WSL 原生盘的符号链接，见 README「Web 版」）；
# web/dist 构建产物**有意入库**——团队成员 pull 后无需装 Node 即可用 Web 版
web/node_modules

# ---- 密钥与本地配置（key 走环境变量，config.json 仅存本机） ----
config.json
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ---- 本地数据 / 生成素材 / 索引库 / 日志（用户数据不上传） ----
outputs/
data/
logs/

# ---- 备份与临时文件 ----
*.bak
*.bak-*
*.tmp

# ---- Claude Code 会话目录与并行工作树（含整仓副本） ----
.claude/

# ---- IDE / 系统文件 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
web/tsconfig.tsbuildinfo
