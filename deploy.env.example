# Copy to an ignored file such as .deploy/staging.env.
# Each environment needs its own project name, runtime directory and credentials.
COMPOSE_PROJECT_NAME=meta-creative-staging
APP_IMAGE=meta-creative-tool:staging-local
APP_PORT=18001
RUNTIME_DIR=./.deploy/staging
POSTGRES_USER=meta
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
POSTGRES_DB=meta_creative
SITE_ADDRESS=test.wanghongyu.online
